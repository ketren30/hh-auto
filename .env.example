# Copy to `.env` locally (do not commit — файл в .gitignore).
# Client secret НЕ используйте с префиксом VITE_ (попадёт в браузерный бандл).

VITE_HH_CLIENT_ID=
# Только для confidential OAuth в dev: прокси в vite.config подставит секрет на сервере.
HH_CLIENT_SECRET=
VITE_HH_TOKEN_PROXY=true
# GET/POST к api.hh.ru через прокси Vite в dev (иначе NetworkError из‑за CORS).
VITE_HH_API_PROXY=true

# Совпадает с redirect URI в кабинете hh (если там уже зафиксирован localhost:3000):
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# Если полный URI не задаёте — только путь (не указывайте сюда https://localhost… — hh вернёт ошибку redirect_uri):
# VITE_OAUTH_REDIRECT_PATH=/oauth/callback
