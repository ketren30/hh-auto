# Copy to `.env` locally (do not commit — файл в .gitignore).
# Client secret НЕ используйте с префиксом VITE_ (попадёт в браузерный бандл).

VITE_HH_CLIENT_ID=
# Почта для заголовка HH-User-Agent (требование api.hh.ru): формат MyApp/1.0 (you@domain)
VITE_HH_CONTACT_EMAIL=
# Или целиком заголовок (имя именно VITE_HH_USER_AGENT — подчёркивание, не дефис; при пробелах используйте кавычки):
# VITE_HH_USER_AGENT="MyApp/1.0 (you@domain)"
# Только для confidential OAuth в dev: прокси в vite.config подставит секрет на сервере.
HH_CLIENT_SECRET=
VITE_HH_TOKEN_PROXY=true
# GET/POST к api.hh.ru через прокси Vite в dev (иначе NetworkError из‑за CORS).
VITE_HH_API_PROXY=true

# VITE_HH_OAUTH_ROLE=applicant
# VITE_HH_OAUTH_SKIP_CHOOSE_ACCOUNT=false
# Строка scope через пробел — как в настройках приложения hh (если не задано, используются встроенные):
# VITE_HH_OAUTH_SCOPE="openid profile email applicant_saved_searches applicant_negotiations"

# Публичная ссылка на резюме (после /resume/ — тот же id, что в POST /negotiations). Если список резюме через API недоступен:
# VITE_HH_RESUME_URL=https://adler.hh.ru/resume/8991f19eff0b60cd240039ed1f7464386c3950
# Или только id (устойчивее парсинга ссылки):
# VITE_HH_RESUME_ID=8991f19eff0b60cd240039ed1f7464386c3950

# Совпадает с redirect URI в кабинете hh (если там уже зафиксирован localhost:3000):
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
# Если полный URI не задаёте — только путь (не указывайте сюда https://localhost… — hh вернёт ошибку redirect_uri):
# VITE_OAUTH_REDIRECT_PATH=/oauth/callback
